APP_NAME=evault-documents
APP_PORT=8082

DATABASE_URL=mysql+aiomysql://root@localhost:3306/evault_documents

PINATA_JWT=
PINATA_API_KEY=
PINATA_SECRET_API_KEY=

BLOCKCHAIN_SERVICE_URL=http://localhost:8083
AUDIT_SERVICE_URL=http://localhost:8084
NOTIFICATION_SERVICE_URL=http://localhost:8085
INTEGRATION_SERVICE_URL=http://localhost:8086

MAX_FILE_SIZE_MB=20
ENABLE_AI_CLASSIFICATION=false

# Must match evault-auth jwt.secret when verifying tokens in production
JWT_SECRET=changeme-use-a-long-random-secret-in-production-at-least-256-bits

# Set false in production to reject unauthenticated requests
ALLOW_MOCK_AUTH=true

# 32-byte hex key for AES-GCM (demo placeholder — replace in production)
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
