# Document service (scratch_doc_service)
ENCRYPTION_MASTER_KEY=   # required: 64 hex chars (32 bytes)
# Optional: older master keys (comma-separated) so docs encrypted before rotation still decrypt
ENCRYPTION_MASTER_KEY_PREVIOUS=
PINATA_JWT=              # or set PINATA_JWT=mock for local ciphertext store only
# Optional dedicated gateway, e.g. https://your-gateway.mypinata.cloud/ipfs
PINATA_GATEWAY_URL=
PINATA_API_KEY=
PINATA_SECRET_API_KEY=
DATABASE_URL=mysql+aiomysql://root@localhost:3306/evault_documents
JWT_SECRET=              # must match evault-auth
ALLOW_MOCK_AUTH=false
BLOCKCHAIN_SERVICE_URL=http://localhost:8083
AUDIT_SERVICE_URL=http://localhost:8084

# Integration service (identity commitment)
# AADHAAR_HMAC_SECRET=   # optional; else uses ENCRYPTION_MASTER_KEY

# Blockchain (evault-blockchain)
# BLOCKCHAIN_PRIVATE_KEY / PRIVATE_KEY — service wallet (never commit)
# CONTRACT_ADDRESS=
# BLOCKCHAIN_MOCK=false
# BLOCKCHAIN_AUTO_MOCK=false
# BLOCKCHAIN_MOCK_ON_ERROR=false
