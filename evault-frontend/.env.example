# Leave empty in local dev so requests stay same-origin and Vite proxies to the gateway
# (avoids browser CORS / Network Error). Example if you must hit the gateway directly:
# VITE_GATEWAY_URL=http://localhost:8080
VITE_GATEWAY_URL=

# Allow email/password demo auth in Auth & Audit tab (backend itself is wallet JWT only)
VITE_ENABLE_DEMO_AUTH=true
